{% extends "layout.twig" %}

{% block title %}Galaxies{% endblock %}

{% block content %}
  <h2>All Galaxies</h2>
  <ul>
    {% for galaxy in galaxies %}
      <li><a href="/galaxies/{{ galaxy.id }}">{{ galaxy.name }}</a></li>
    {% endfor %}
  </ul>
  <a href="/galaxies/new">+ Create New Galaxy</a>
{% endblock %}

