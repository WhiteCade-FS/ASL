{% extends "layout.twig" %}

{% block title %}Planets{% endblock %}

{% block content %}
  <h2>All Planets</h2>
  <ul>
    {% for planet in planets %}
      <li>
        <a href="/planets/{{ planet.id }}">{{ planet.name }}</a>
      </li>
    {% endfor %}
  </ul>
  <a href="/planets/new">➕ New Planet</a>
{% endblock %}

