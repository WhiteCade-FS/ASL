<form action="{{ action }}" method="POST" enctype="multipart/form-data">
  <label>Name:</label><br>
  <input type="text" name="name" value="{{ star.name | default('') }}" required><br><br>

  <label>Size:</label><br>
  <input type="number" name="size" value="{{ star.size | default('') }}" required><br><br>

  <label>Description:</label><br>
  <textarea name="description" rows="5">{{ star.description | default('') }}</textarea><br><br>

  {% if star.image %}
    <label>Current Image:</label><br>
    <img src="/uploads/stars/{{ star.image }}" alt="{{ star.name }}" width="200"><br><br>
  {% endif %}

  <label>Upload Image:</label><br>
  <input type="file" name="image"><br><br>

  <button type="submit">{{ buttonLabel }}</button>
</form>

