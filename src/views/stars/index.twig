{% extends "layout.twig" %}

{% block title %}Stars{% endblock %}

{% block content %}
  <h2>All Stars</h2>
  <ul>
    {% for star in stars %}
      <li>
        <a href="/stars/{{ star.id }}">{{ star.name }}</a>
      </li>
    {% endfor %}
  </ul>
  <a href="/stars/new">➕ New Star</a>
{% endblock %}

